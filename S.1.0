<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>SuaLoja | Marketplace Verde</title>
    <style>
        :root {
            --verde-principal: #2e7d32;
            --verde-claro: #4caf50;
            --fundo-cinza: #f5f5f5;
        }

        body { font-family: Arial, sans-serif; margin: 0; background: var(--fundo-cinza); }

        /* --- CABEÇALHO --- */
        header { background: var(--verde-principal); padding: 15px 50px; color: white; }
        
        .nav-top { display: flex; align-items: center; justify-content: space-between; }

        .search-bar { width: 60%; display: flex; }
        .search-bar input { width: 100%; padding: 10px; border: none; border-radius: 4px 0 0 4px; }
        .search-bar button { padding: 10px 20px; background: #1b5e20; color: white; border: none; border-radius: 0 4px 4px 0; cursor: pointer; }

        .user-menu a { color: white; text-decoration: none; margin-left: 20px; font-weight: bold; }

        /* --- ÁREA DO VENDEDOR --- */
        .seller-banner { background: white; margin: 20px 50px; padding: 30px; border-radius: 8px; border-left: 8px solid var(--verde-claro); }
        .btn-vender { background: var(--verde-principal); color: white; padding: 12px 25px; border: none; border-radius: 5px; cursor: pointer; font-size: 16px; }

        /* --- FEED DE PRODUTOS --- */
        .grid-produtos { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 20px; padding: 50px; }
        .card-produto { background: white; padding: 10px; border-radius: 5px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        .img-placeholder { background: #ddd; height: 180px; width: 100%; border-radius: 4px; }
        .preco { color: var(--verde-principal); font-size: 20px; font-weight: bold; }
    </style>
</head>
<body>

<header>
    <div class="nav-top">
        <div class="logo"><h2>V-Market</h2></div>
        <div class="search-bar">
            <input type="text" placeholder="Pesquise o que quiser aqui...">
            <button>Buscar</button>
        </div>
        <div class="user-menu">
            <a href="#">Minhas Compras</a>
            <a href="#">Perfil (Eu)</a>
        </div>
    </div>
</header>

<section class="seller-banner">
    <h1>Torne-se um Vendedor</h1>
    <p>Abra sua loja agora e alcance milhares de compradores!</p>
    <p><strong>Atenção:</strong> É necessário ter +18 anos e documentos válidos para o cadastro.</p>
    <button class="btn-vender" onclick="abrirCadastro()">Criar Minha Loja</button>
</section>

<main class="grid-produtos">
    <div class="card-produto">
        <div class="img-placeholder"></div>
        <p>Nome do Produto Exemplo</p>
        <p class="preco">R$ 49,90</p>
    </div>
    </main>

<script>
    function abrirCadastro() {
        alert("Redirecionando para o fluxo de cadastro de vendedor (Verificação de Maioridade e CPF/CNPJ)...");
    }
</script>

</body>
</html>
